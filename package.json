{
  "name": "gulp",
  "version": "2.0.0",
  "description": "Сборка Gulp+Webpack+Babel",
  "main": "gulpfile.js",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "gulp",
    "build": "gulp build --build",
    "zip": "gulp deployZIP --build",
    "deployFTP": "gulp deployFTP --build",
    "svgSprite": "gulp createSvgSprite",
    "svgSprive": "gulp createSvgSprite",
    "deploy": "gh-pages -d dist",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,html,css,scss,md,yaml,yml}\"",
    "predeploy": "npm run build"
  },
  "browserslist": [
    "defaults",
    "> 0.2%",
    "Safari >= 14",
    "iOS >= 14",
    "not dead",
    "not op_mini all"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero671/gulp"
  },
  "keywords": [
    "gulp",
    "webpack",
    "js",
    "css",
    "scss",
    "html"
  ],
  "author": "Kachalko Stanislav",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "cssnano": "^7.1.9",
    "fancy-log": "^2.0.0",
    "fonteditor-core": "^2.6.3",
    "gh-pages": "^6.3.0",
    "gulp": "^5.0.1",
    "gulp-file-include": "^2.3.0",
    "gulp-html-minifier-terser": "^7.1.0",
    "gulp-if": "^3.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-notify": "^5.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-sass-glob": "^1.1.0",
    "gulp-svg-sprite": "^2.0.3",
    "gulp-zip": "^6.1.0",
    "handlebars": "^4.7.10",
    "postcss": "^8.5.31",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.0",
    "sharp": "^0.35.5",
    "terser-webpack-plugin": "^5.6.1",
    "vinyl-ftp": "^0.6.1",
    "wawoff2": "^2.0.1",
    "webpack": "^5.112.0"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "core-js": "^3.51.0",
    "imask": "^7.6.1",
    "nouislider": "^15.8.1",
    "pristinejs": "^1.1.0",
    "swiper": "^14.3.0"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "^11.1.1"
    }
  }
}
